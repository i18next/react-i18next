{
  "name": "simple-multi-namespaces",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "i18next": "^26.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "i18next-resources-for-ts": "^2.1.0",
